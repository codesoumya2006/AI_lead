# Copy to terraform.tfvars only after staging project and security controls are approved.
project_id                  = "replace-with-staging-project-id"
project_number              = "replace-with-staging-project-number"
billing_account_id          = ""
region                      = "europe-west2"
environment                 = "staging"
state_bucket_name           = "replace-with-globally-unique-staging-state-bucket"
api_image_digest            = ""
web_image_digest            = ""
enable_service_deployments  = false
oidc_audience               = ""
frontend_origin             = ""
monthly_budget_usd          = 200
notification_channels       = []
